<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.octopusden.octopus.jira</groupId>
        <artifactId>jira-utils-parent</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <properties>
        <!-- 12 SpotBugs findings, every one of them EI_EXPOSE_REP2 on constructors that store the
             Jira managers handed to them. A ratchet, not an endorsement: it stops the count
             growing. This module has no tests, so JaCoCo produces no data and its gate is inert. -->
        <octopus.quality.maxViolations.spotbugs>12</octopus.quality.maxViolations.spotbugs>
    </properties>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>helper-services</artifactId>
    <name>Octopus Jira Utils Library Helper Services</name>

    <dependencies>
        <dependency>
            <groupId>org.octopusden.octopus.jira</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.atlassian.jira</groupId>
            <artifactId>jira-api</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jta</groupId>
                    <artifactId>jta</artifactId>
                </exclusion>
            </exclusions>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.0</version>
        </dependency>
    </dependencies>

</project>
